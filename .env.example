# ==============================================================================
# SOCIALCRAFT — ENVIRONMENT TEMPLATE (.env.example)
# ==============================================================================
# Copy this file to .env and replace placeholder values with your real keys.
# ==============================================================================

# ── 1. Mega S4 / AWS S3 Compatible Object Storage ───────────────────────────
S4_ACCESS_KEY=your_s4_access_key
S4_SECRET_KEY=your_s4_secret_key
S4_ENDPOINT=socialgrow.s3.g.megas4.com
S4_BUCKET=socialgrow
S4_REGION=eu-central-1

VITE_S4_ACCESS_KEY=your_s4_access_key
VITE_S4_SECRET_KEY=your_s4_secret_key
VITE_S4_ENDPOINT=socialgrow.s3.g.megas4.com
VITE_S4_BUCKET=socialgrow
VITE_S4_REGION=eu-central-1

# ── 2. KIE.AI Image Generation Engine (Nano-Banana) ────────────────────────
KIE_API_KEY=your_kie_api_key
VITE_KIE_API_KEY=your_kie_api_key

# ── 3. Post For Me API (Multi-Platform Publishing & Scheduling) ─────────────
POSTFORME_API_KEY=pfm_live_...
VITE_POSTFORME_API_KEY=pfm_live_...

# ── 4. Zernio Webhook Signature Verification ────────────────────────────────
ZERNIO_WEBHOOK_SECRET=your_zernio_webhook_secret
VITE_ZERNIO_WEBHOOK_SECRET=your_zernio_webhook_secret

# ── 5. Supabase Database & Authentication ───────────────────────────────────
SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key
VITE_SUPABASE_PUBLISHABLE_KEY=your_publishable_key
